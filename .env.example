NODE_ENV=development
PORT=3027
RUN_LIVE_TESTS=false

# Zoho CRM (OAuth 2.0)
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CRM_API_DOMAIN=https://www.zohoapis.com/crm/v2
ZOHO_CRM_ACCOUNTS_URL=https://accounts.zoho.com

# Zoho Projects (OAuth 2.0)
ZOHO_PROJECTS_CLIENT_ID=
ZOHO_PROJECTS_CLIENT_SECRET=
ZOHO_PROJECTS_REFRESH_TOKEN=
ZOHO_PROJECTS_API_DOMAIN=https://projectsapi.zoho.com/restapi
ZOHO_PROJECTS_PORTAL_ID=

# QuickBooks Online (OAuth 2.0 - Strictly Read-Only)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_ENVIRONMENT=sandbox

# Microsoft 365 / Microsoft Graph (Azure AD App Registration)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SHAREPOINT_SITE_ID=

# LLM Provider Configuration (M3 - Google Gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL_PRIMARY=gemini-2.5-pro
LLM_MODEL_FAST=gemini-2.5-flash
LLM_DAILY_COST_CAP_USD=15.00
LLM_MAX_CALLS_PER_HOUR=30

